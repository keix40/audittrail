# API
DEBUG=false
API_KEY_PEPPER=change-me-use-long-random-string
BOOTSTRAP_ADMIN_TOKEN=change-me-bootstrap-admin-token

# Database & Redis
DATABASE_URL=postgresql+psycopg://audittrail:audittrail@localhost:5432/audittrail
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# GitHub App (required for PR webhooks and check runs)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Scanner sandbox
SCANNER_DOCKER_IMAGE=audittrail-scanner:local
WORK_DIR=/var/audittrail/work
SCANNER_WORK_VOLUME_NAME=audittrail_scanwork
SCANNER_NETWORK_DISABLED=true
SCANNER_MEMORY_LIMIT=512m
SCANNER_TIMEOUT_SECONDS=300

# Optional LLM summary (leave empty for deterministic fallback)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
