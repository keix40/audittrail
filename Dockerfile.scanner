FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

# Semgrep + Bandit via pip
RUN pip install --no-cache-dir semgrep bandit

COPY scanner/semgrep /opt/audittrail-semgrep
RUN semgrep --config /opt/audittrail-semgrep --validate --metrics=off

# Gitleaks
ARG GITLEAKS_VERSION=8.21.2
RUN curl -sSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
    | tar -xz -C /usr/local/bin gitleaks

# Trivy + offline vulnerability DB
RUN curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin
ENV TRIVY_CACHE_DIR=/trivy-cache
RUN mkdir -p /trivy-cache && trivy filesystem --download-db-only --cache-dir /trivy-cache

WORKDIR /workspace
ENTRYPOINT []
CMD ["semgrep", "--help"]
